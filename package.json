{
    "name": "testar-state-model-dashboard",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview --host 127.0.0.1",
        "test": "vitest run",
        "test:browser": "npm run build && playwright test",
        "prepare:conformance": "tsx tools/prepare-conformance.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "cytoscape": "3.34.4",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@playwright/test": "1.64.1",
        "@types/cytoscape": "3.21.9",
        "@types/node": "26.6.5",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "fflate": "0.8.3",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    },
    "engines": {
        "node": ">=24"
    }
}
